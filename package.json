{
	"name": "@lesjoursfr/bin-wrapper",
	"version": "13.1.2",
	"description": "Binary wrapper that makes your programs seamlessly available as local dependencies",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lesjoursfr/bin-wrapper.git"
	},
	"homepage": "https://github.com/lesjoursfr/bin-wrapper#readme",
	"bugs": {
		"url": "https://github.com/lesjoursfr/bin-wrapper/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": {
		"name": "Kevin Mårtensson",
		"email": "kevinmartensson@gmail.com",
		"url": "https://github.com/kevva"
	},
	"engines": {
		"node": "22.x || 24.x || 26.x"
	},
	"keywords": [
		"bin",
		"check",
		"local",
		"wrapper"
	],
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"type": "module",
	"scripts": {
		"freshlock": "rm -rf node_modules/ && rm .yarn/install-state.gz && rm yarn.lock && yarn",
		"check-lint": "eslint",
		"check-format": "prettier --check .",
		"check-tsc": "tsc --noEmit",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"build": "tsc",
		"test": "NODE_OPTIONS='--loader=ts-node/esm' mocha"
	},
	"dependencies": {
		"@lesjoursfr/bin-check": "^8.1.2",
		"@lesjoursfr/bin-version": "^8.1.2",
		"arch": "^3.0.0",
		"axios": "^1.20.0",
		"content-disposition": "^2.0.1",
		"file-type": "^22.1.1",
		"semver": "^7.8.5",
		"semver-truncate": "^3.0.0",
		"tar": "^7.5.22"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tsconfig/node22": "22.0.6",
		"@types/mocha": "10.0.10",
		"@types/node": "24.19.0",
		"@types/semver": "7.8.0",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.13.0",
		"isexe": "4.0.0",
		"mocha": "11.8.0",
		"nock": "14.0.17",
		"prettier": "3.9.9",
		"tempy": "3.2.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0"
	},
	"packageManager": "yarn@4.18.1"
}
